{
  "name": "wuxia-mud",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:fast": "node scripts/checkStrictSchemas.mjs && node scripts/checkPromptCopy.mjs && eslint \"src/**/*.{js,jsx}\" \"e2e/**/*.mjs\" && vitest run && npm run test:server",
    "verify": "node scripts/checkStrictSchemas.mjs && node scripts/checkPromptCopy.mjs && eslint \"src/**/*.{js,jsx}\" \"e2e/**/*.mjs\" && vitest run && npm run test:server && vite build --config vite.config.pages.js",
    "ratchet": "node scripts/ratchet.mjs",
    "copy-gate": "node scripts/checkPromptCopy.mjs",
    "docs-gate": "node scripts/checkAiChainDocs.mjs",
    "art:prompts": "node scripts/art/buildArtPrompts.mjs",
    "design:prototype": "node scripts/design/buildPrototype.mjs",
    "stats": "node scripts/ratchet.mjs --stats",
    "tree": "node scripts/tree.mjs",
    "e2e": "node e2e/run.mjs",
    "dev:qa": "node e2e/harness/server.mjs",
    "test:server": "node --test server/memory-hub/hubCore.test.mjs",
    "shadow:report": "node scripts/shadowCoverageReport.mjs",
    "shadow:sample": "vitest run src/tests/shadowSampling.test.js",
    "release:report": "node scripts/releaseReport.mjs",
    "version:bump": "node scripts/bumpVersion.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
